# regenerable data (run prepare_data.py after downloading the corpus)
data/*.txt
data/*.bin
data/*.tmp
# full checkpoints with optimizer state (>100MB, over GitHub's file limit); runs/main/model.pt has the weights
runs/**/ckpt.pt
runs/**/ckpt_step*.pt
# build / cache
__pycache__/
build/
*.so
slurm/.reported
data/pg19/raw/
data/pg19/*.bin
data/pg19/*.tmp
data/fineweb/raw/
data/fineweb/*.bin
data/fineweb/*.tmp
slurm/.g26seen
slurm/claude_session.id
slurm/claude_session.stop
# what a running job writes (slurm/train.sbatch copies them to stdout.log and log.jsonl): never touched by git
runs/**/*.live.*
# the FPGA prototype's integer tables (hw_export.py, ~126 MB, regenerable) and the reference binary
runs/**/hw/tables.bin
runs/**/hw/windows.bin
runs/**/hw/logp.bin
/hw_ref
# Vitis build outputs and packed tables (fpga/Makefile, fpga/pack.py)
fpga/build/
fpga/host_nb*
fpga/_x/
fpga/.Xil/
runs/**/fpga/weights.bin
runs/**/fpga/params.bin
runs/**/fpga/aux.bin
